configfile: "config/config.yaml"
SAMPLES = config["samples"]

rule all:
    input:
        "results/multiqc/multiqc_report.html"

rule fastp:
	#fastp(trimming)
	input:
		r1="data/{sample}_R1.fastq.gz",
		r2="data/{sample}_R2.fastq.gz"
	output:
		r1="results/fastp/{sample}_R1.trimmed.fastq.gz",
		r2="results/fastp/{sample}_R2.trimmed.fastq.gz",
		html="results/fastp/{sample}_fastp.html",
		json="results/fastp/{sample}_fastp.json"
	shell:
		"""
		mkdir -p results/fastp
		fastp\
			-i {input.r1} -I {input.r2} \
			-o {output.r1} -O {output.r2} \
			-h {output.html} -O {output.json}
		"""

rule FastQC:
	#fastQC trimming output
	input:
		"results/fastp/{sample}_{read}.trimmed.fastq.gz"
	output:
		"results/fastqc/{sample}_{read}_fastqc.html"
	params:
		outdir="results/fastqc"
	shell:
		"""
		mkdir -p {params.outdir}
		fastqc {input} -o {params.outdir}
		"""

rule Multiqc:
	input:
		expand("results/fastqc/{sample}_{read}_fastqc.html",
			sample=SAMPLES,
			read=["R1", "R2"])
	output:
		"results/multiqc/multiqc_report.html"
	shell:
		"""
		mkdir -p results/multiqc
		multiqc results/ -o results/multiqc/
		"""
